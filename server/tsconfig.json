{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],

    "rootDir": "./src",
    "outDir": "./dist",

    "moduleResolution": "node",

    "strict": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "sourceMap": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}