# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Prisma Database URL (PostgreSQL or MySQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_10_characters
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_10_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_10_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Cloudinary Configuration (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration (Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration
# Options: fake, resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com